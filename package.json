{
  "name": "@datalayer/slack",
  "version": "0.1.0",
  "private": true,
  "description": "The @Datalayer Slack application",
  "author": "Datalayer",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "manifests"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:imports && npm run manifest:check && npm test && npm run build",
    "check:imports": "node scripts/check-forbidden-imports.mjs",
    "dev": "tsx watch src/index.ts",
    "dev:http": "DATALAYER_SLACK_TRANSPORT=http tsx watch src/index.ts",
    "dev:socket": "DATALAYER_SLACK_TRANSPORT=socket tsx watch src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test scripts",
    "manifest:check": "node scripts/render-manifest.mjs --check",
    "manifest:render": "node scripts/render-manifest.mjs",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0",
    "@slack/types": "3.2.0",
    "@slack/web-api": "8.2.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.12.2",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
