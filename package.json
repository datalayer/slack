{
  "name": "@datalayer/slack",
  "version": "0.1.0",
  "private": true,
  "description": "The @Datalayer Slack application",
  "author": "Datalayer",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "config": {
    "agentRuntimesVersion": "1.5.55"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:lib": "tsc -p tsconfig.build.json",
    "bundle": "node --import tsx scripts/bundle.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:imports && npm run manifest:check && npm test && npm run bundle",
    "check:imports": "node --import tsx scripts/bundle.ts --check",
    "check:installed": "node --import tsx scripts/check-installed.ts",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:http": "DATALAYER_SLACK_TRANSPORT=http node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "dev:socket": "DATALAYER_SLACK_TRANSPORT=socket node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "fetch:agent-runtimes": "node scripts/fetch-agent-runtimes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test scripts",
    "manifest:check": "node --import tsx scripts/verify-manifest.ts",
    "manifest:render": "node --import tsx scripts/render-manifest.ts",
    "slack-app": "node --import tsx scripts/slack-app.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "watch:lib": "tsc -w -p tsconfig.build.json"
  },
  "dependencies": {
    "@slack/bolt": "5.1.0",
    "@slack/types": "3.2.0",
    "@slack/web-api": "8.2.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "@datalayer/agent-runtimes": ">=1.5.55 <2"
  },
  "peerDependenciesMeta": {
    "@datalayer/agent-runtimes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@types/node": "24.12.2",
    "@types/pg": "8.23.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.2",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.0.18",
    "yaml": "2.9.1"
  }
}
