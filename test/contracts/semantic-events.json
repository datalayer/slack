{
  "version": 1,
  "about": "The semantic agent events the Slack adapter renders (plans/SLACK.md §4.2, S-004, S-205), and the AG-UI events of agent-runtimes' session API (agent_runtimes/routes/apps.py, agent_runtimes/loop/apps/external_turns.py) each reduces to. src/ag-ui.ts reduces every case; src/presentation.ts renders only these kinds.",
  "kinds": [
    "text",
    "progress",
    "tool",
    "approval",
    "table",
    "file",
    "citation",
    "ask",
    "completion",
    "stop",
    "error"
  ],
  "producers": {
    "text": "AG-UI TEXT_MESSAGE_CONTENT / TEXT_MESSAGE_CHUNK delta",
    "progress": "AG-UI STEP_STARTED stepName",
    "tool": "AG-UI TOOL_CALL_START (running), TOOL_CALL_RESULT (complete, or failed when success is false)",
    "approval": "AG-UI TOOL_CALL_RESULT whose result says pending_approval; the decision itself arrives as an approval.requested delivery",
    "table": "a Markdown table in the answer (src/semantic.ts answerParts); no AG-UI event carries one",
    "file": "none in agent-runtimes 1.5.44: reserved, rendered as a safe HTTPS link when produced",
    "citation": "an HTTPS Markdown link in the answer (answerParts); no AG-UI event carries one",
    "ask": "AG-UI RUN_FINISHED with result.asking, or CUSTOM loop.ask (agent_runtimes/loop/apps/sessions.py question_of)",
    "completion": "AG-UI RUN_FINISHED without asking",
    "stop": "CUSTOM loop.turn with state stopped",
    "error": "AG-UI RUN_ERROR message"
  },
